{
  "name": "mobility-reliability-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm check:docs && pnpm -r --if-present check",
    "check:docs": "node scripts/check-doc-links.mjs && node scripts/check-doc-integrity.mjs",
    "check:firebase": "pnpm --filter @mobility-reliability/firebase-rules test",
    "doctor": "node scripts/doctor.mjs",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
