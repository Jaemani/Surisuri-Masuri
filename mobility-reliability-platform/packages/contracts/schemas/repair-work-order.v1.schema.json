{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.internal/repair-work-order.v1.schema.json",
  "title": "RepairWorkOrderV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "workOrderId", "tenantId", "requesterPersonId",
    "deviceId", "status", "symptoms", "assignmentMode", "createdAt", "revision"
  ],
  "properties": {
    "schemaVersion": { "const": "repair-work-order.v1" },
    "workOrderId": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "format": "uuid" },
    "requesterPersonId": { "type": "string", "format": "uuid" },
    "deviceId": { "type": "string", "format": "uuid" },
    "status": {
      "enum": [
        "requested", "under_review", "assigned", "scheduled", "in_progress",
        "repairer_submitted", "center_verified", "completed", "rejected",
        "cancelled", "needs_correction", "reopened"
      ]
    },
    "symptoms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["unusual_noise", "battery_drain", "brake_delay", "tire_issue", "control_issue", "seat_or_frame", "other"]
      }
    },
    "description": { "type": ["string", "null"], "maxLength": 1000 },
    "attachmentRefs": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "priority": { "enum": ["routine", "soon", "urgent_review"] },
    "assignmentMode": { "enum": ["center_assigned", "user_selectable"] },
    "repairStationId": { "type": ["string", "null"], "format": "uuid" },
    "repairerPersonId": { "type": ["string", "null"], "format": "uuid" },
    "scheduledAt": { "type": ["string", "null"], "format": "date-time" },
    "quotedAmountKrw": { "type": ["integer", "null"], "minimum": 0 },
    "billedAmountKrw": { "type": ["integer", "null"], "minimum": 0 },
    "subsidyReservedKrw": { "type": ["integer", "null"], "minimum": 0 },
    "subsidyExecutedKrw": { "type": ["integer", "null"], "minimum": 0 },
    "copayAmountKrw": { "type": ["integer", "null"], "minimum": 0 },
    "submittedAt": { "type": ["string", "null"], "format": "date-time" },
    "verifiedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["assigned", "scheduled", "in_progress", "repairer_submitted", "center_verified", "completed"] } } },
      "then": {
        "properties": { "repairStationId": { "type": "string", "format": "uuid" } },
        "required": ["repairStationId"]
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["repairer_submitted", "center_verified", "completed"] } } },
      "then": {
        "properties": {
          "billedAmountKrw": { "type": "integer", "minimum": 0 },
          "submittedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["billedAmountKrw", "submittedAt"]
      }
    }
  ]
}
