{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.internal/quality-field-features.v1.schema.json",
  "title": "QualityFieldFeaturesV1",
  "description": "Coordinate-free field holdout features with evaluation-only lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "featureId", "holdoutId", "holdoutManifestSha256", "traceId", "telemetryBatchId", "telemetrySha256", "extractorVersion", "extractionStatus", "reasonCode", "features", "featureSha256"],
  "properties": {
    "schemaVersion": { "const": "quality-field-features.v1" },
    "featureId": { "type": "string", "format": "uuid" },
    "holdoutId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "holdoutManifestSha256": { "$ref": "#/$defs/sha256" },
    "traceId": { "type": "string", "format": "uuid" },
    "telemetryBatchId": { "type": "string", "format": "uuid" },
    "telemetrySha256": { "$ref": "#/$defs/sha256" },
    "extractorVersion": { "const": "r07-feature-extractor.v1" },
    "extractionStatus": { "enum": ["ok", "review_required"] },
    "reasonCode": {
      "type": ["string", "null"],
      "enum": ["insufficient_samples", "missing_timestamps", "non_monotonic_time", "invalid_or_missing_accuracy", "out_of_range", "non_finite_value", "contract_mismatch", "extractor_error", "telemetry_batch_invalid", "samples_invalid", "sequence_invalid", "timestamp_invalid", "timestamp_order_invalid", "coordinate_nonfinite", "coordinate_range_invalid", "accuracy_invalid", "speed_invalid", "heading_invalid", "altitude_invalid", "sent_timestamp_invalid", "sent_timestamp_chronology_invalid", null]
    },
    "features": {
      "anyOf": [
        { "$ref": "#/$defs/numericFeatures" },
        { "type": "null" }
      ]
    },
    "featureSha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    { "if": { "properties": { "extractionStatus": { "const": "ok" } } }, "then": { "properties": { "reasonCode": { "type": "null" }, "features": { "$ref": "#/$defs/numericFeatures" } } } },
    { "if": { "properties": { "extractionStatus": { "const": "review_required" } } }, "then": { "properties": { "reasonCode": { "type": "string" }, "features": { "type": "null" } } } }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "numericFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleCount", "observedDurationS", "pathLengthM", "displacementM",
        "meanStepDistanceM", "maxStepDistanceM", "meanSampleIntervalS",
        "maxSampleIntervalS", "reportedSpeedMeanMps", "reportedSpeedMaxMps",
        "reportedSpeedStdMps", "derivedSpeedMeanMps", "derivedSpeedMaxMps",
        "reportedAccelerationMeanAbsMps2", "reportedAccelerationMaxAbsMps2",
        "headingChangeMeanDeg", "headingChangeMaxDeg", "headingChangeTotalDeg",
        "headingChangeCount", "stationaryRatio", "accuracyMeanM", "accuracyMaxM",
        "accuracyMissingRatio", "speedMissingRatio", "headingMissingRatio",
        "altitudeMissingRatio", "optionalFieldMissingRatio", "sentAfterLastSampleS"
      ],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 1, "maximum": 500 },
        "observedDurationS": { "type": "number", "minimum": 0, "maximum": 604800 },
        "pathLengthM": { "type": "number", "minimum": 0, "maximum": 100000000 },
        "displacementM": { "type": "number", "minimum": 0, "maximum": 100000000 },
        "meanStepDistanceM": { "type": "number", "minimum": 0, "maximum": 100000000 },
        "maxStepDistanceM": { "type": "number", "minimum": 0, "maximum": 100000000 },
        "meanSampleIntervalS": { "type": "number", "minimum": 0, "maximum": 86400 },
        "maxSampleIntervalS": { "type": "number", "minimum": 0, "maximum": 86400 },
        "reportedSpeedMeanMps": { "type": "number", "minimum": 0, "maximum": 100000 },
        "reportedSpeedMaxMps": { "type": "number", "minimum": 0, "maximum": 100000 },
        "reportedSpeedStdMps": { "type": "number", "minimum": 0, "maximum": 100000 },
        "derivedSpeedMeanMps": { "type": "number", "minimum": 0, "maximum": 100000 },
        "derivedSpeedMaxMps": { "type": "number", "minimum": 0, "maximum": 100000 },
        "reportedAccelerationMeanAbsMps2": { "type": "number", "minimum": 0, "maximum": 100000 },
        "reportedAccelerationMaxAbsMps2": { "type": "number", "minimum": 0, "maximum": 100000 },
        "headingChangeMeanDeg": { "type": "number", "minimum": 0, "maximum": 180 },
        "headingChangeMaxDeg": { "type": "number", "minimum": 0, "maximum": 180 },
        "headingChangeTotalDeg": { "type": "number", "minimum": 0, "maximum": 90000 },
        "headingChangeCount": { "type": "integer", "minimum": 0, "maximum": 499 },
        "stationaryRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "accuracyMeanM": { "type": "number", "minimum": 0, "maximum": 100000 },
        "accuracyMaxM": { "type": "number", "minimum": 0, "maximum": 100000 },
        "accuracyMissingRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "speedMissingRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "headingMissingRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "altitudeMissingRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "optionalFieldMissingRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "sentAfterLastSampleS": { "type": "number", "minimum": 0, "maximum": 86400 }
      }
    }
  }
}
