{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.internal/quality-dataset-manifest.v1.schema.json",
  "title": "QualityDatasetManifestV1",
  "description": "Reproducibility manifest for a group/time-split telemetry quality dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetVersion",
    "telemetrySchemaVersion",
    "labelSchemaVersion",
    "featureSchemaVersion",
    "generatorVersion",
    "splitStrategy",
    "seed",
    "sourceKind",
    "createdAt",
    "datasetSha256",
    "traceCount",
    "labelCounts",
    "splitCounts",
    "traces"
  ],
  "properties": {
    "schemaVersion": { "const": "quality-dataset-manifest.v1" },
    "datasetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "telemetrySchemaVersion": { "const": "telemetry-batch.v2" },
    "labelSchemaVersion": { "const": "quality-label.v1" },
    "featureSchemaVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "generatorVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "splitStrategy": { "const": "group-time-holdout.v1" },
    "seed": { "type": "integer", "minimum": 0 },
    "sourceKind": { "enum": ["synthetic", "developer_device", "field_pilot", "legacy_import"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "datasetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "traceCount": { "type": "integer", "minimum": 1 },
    "labelCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mobility_aid_likely",
        "vehicle_likely",
        "stationary",
        "gps_noise_or_insufficient",
        "review_required",
        "abstained"
      ],
      "properties": {
        "mobility_aid_likely": { "type": "integer", "minimum": 0 },
        "vehicle_likely": { "type": "integer", "minimum": 0 },
        "stationary": { "type": "integer", "minimum": 0 },
        "gps_noise_or_insufficient": { "type": "integer", "minimum": 0 },
        "review_required": { "type": "integer", "minimum": 0 },
        "abstained": { "type": "integer", "minimum": 0 }
      }
    },
    "splitCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": { "type": "integer", "minimum": 0 },
        "validation": { "type": "integer", "minimum": 0 },
        "test": { "type": "integer", "minimum": 0 }
      }
    },
    "traces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/trace" }
    }
  },
  "$defs": {
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traceId",
        "telemetryBatchId",
        "scenarioGroupId",
        "labelId",
        "sourceKind",
        "split",
        "capturedAt",
        "sampleCount",
        "telemetrySha256",
        "benchmarkEligible"
      ],
      "properties": {
        "traceId": { "type": "string", "format": "uuid" },
        "telemetryBatchId": { "type": "string", "format": "uuid" },
        "scenarioGroupId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "labelId": { "type": "string", "format": "uuid" },
        "sourceKind": {
          "type": "string",
          "enum": ["synthetic", "developer_device", "field_pilot", "legacy_import"]
        },
        "split": { "type": "string", "enum": ["train", "validation", "test"] },
        "capturedAt": { "type": "string", "format": "date-time" },
        "sampleCount": { "type": "integer", "minimum": 1, "maximum": 500 },
        "telemetrySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "benchmarkEligible": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sourceKind": { "const": "synthetic" } }
          },
          "then": { "properties": { "benchmarkEligible": { "const": true } } }
        },
        {
          "if": {
            "properties": {
              "sourceKind": { "enum": ["developer_device", "field_pilot", "legacy_import"] }
            }
          },
          "then": { "properties": { "benchmarkEligible": { "const": false } } }
        }
      ]
    }
  }
}
