{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.internal/quality-label.v1.schema.json",
  "title": "QualityLabelV1",
  "description": "A reviewed label for one telemetry trace. The review and abstain states are not training classes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "labelId",
    "traceId",
    "scenarioGroupId",
    "telemetryBatchId",
    "telemetrySchemaVersion",
    "labelState",
    "label",
    "labelSource",
    "confidence",
    "labelGuideVersion",
    "labeledAt"
  ],
  "properties": {
    "schemaVersion": { "const": "quality-label.v1" },
    "labelId": { "type": "string", "format": "uuid" },
    "traceId": { "type": "string", "format": "uuid" },
    "scenarioGroupId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "telemetryBatchId": { "type": "string", "format": "uuid" },
    "telemetrySchemaVersion": { "const": "telemetry-batch.v2" },
    "labelState": {
      "type": "string",
      "enum": ["known", "review_required", "abstained"]
    },
    "label": {
      "type": ["string", "null"],
      "enum": [
        "mobility_aid_likely",
        "vehicle_likely",
        "stationary",
        "gps_noise_or_insufficient",
        null
      ]
    },
    "labelSource": {
      "type": "string",
      "enum": ["synthetic_generator", "human_review", "device_annotation"]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "reviewReason": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 256
    },
    "labelGuideVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "labeledAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "labelState": { "const": "known" } }
      },
      "then": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "mobility_aid_likely",
              "vehicle_likely",
              "stationary",
              "gps_noise_or_insufficient"
            ]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "labelState": { "enum": ["review_required", "abstained"] }
        }
      },
      "then": {
        "required": ["reviewReason"],
        "properties": {
          "label": { "type": "null" },
          "confidence": { "type": "null" },
          "reviewReason": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
