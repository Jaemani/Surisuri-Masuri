{
  "name": "@mobility-reliability/domain-command",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:emulator": "firebase emulators:exec --config ../../firebase.json --project demo-domain-command --only firestore \"vitest run test/firestore-emulator.test.ts test/projection-emulator.test.ts\""
  },
  "dependencies": {
    "@mobility-reliability/domain-workflows": "workspace:*",
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "firebase-tools": "15.24.0"
  }
}
